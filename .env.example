# Copy this file to .env and replace the secret placeholders before use.
ENV=development

# Generate a separate random value for each secret:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-access-token-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-random-refresh-token-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
